generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
  CUSTOMER
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  STANDARD
  DEEP
  MOVE_OUT
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          Role
  phone         String?
  city          String?
  experience    String?
  workerStatus  WorkerStatus @default(PENDING)
  lastLatitude  Float?
  lastLongitude Float?
  lastUpdated   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignedJobs  Job[]        @relation("AssignedWorkerJobs")
}

model Job {
  id               String      @id @default(cuid())
  customerName     String
  customerPhone    String
  customerEmail    String?
  address          String
  serviceType      ServiceType
  scheduledDate    DateTime
  status           JobStatus   @default(PENDING)
  customerPrice    Int         @default(0)
  platformFee      Int         @default(0)
  cleanerPay       Int         @default(0)
  assignedWorkerId String?
  assignedWorker   User?       @relation("AssignedWorkerJobs", fields: [assignedWorkerId], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  notes            JobNote[]

  @@index([status])
  @@index([scheduledDate])
}

model JobNote {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([jobId])
}
